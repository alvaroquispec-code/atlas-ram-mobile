{
  "expo": {
    "name": "Atlas RAM",
    "slug": "atlas-ram-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "atlasram",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Atlas RAM usa la cámara para escanear el código QR de las muestras.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Atlas RAM usa tu ubicación para mostrarte la resistencia antimicrobiana de tu distrito."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Atlas RAM usa el acelerómetro para que puedas agitar el teléfono y recargar la lista."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}